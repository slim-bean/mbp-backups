#!/bin/bash
# Take an APFS local snapshot (a Time Machine local snapshot) of this Mac.
#
# Snapshots created this way are browsable in the "Enter Time Machine" UI,
# mountable with `mount-snapshot`, and usable as a full-volume restore source
# from macOS Recovery. They auto-expire after ~24 hours.
set -euo pipefail

LOG_DIR="$HOME/Library/Logs/mbp-backups"
LOG_FILE="$LOG_DIR/snapshots.log"
mkdir -p "$LOG_DIR"

if out=$(tmutil localsnapshot 2>&1); then
  echo "$(date '+%Y-%m-%d %H:%M:%S') OK   ${out//$'\n'/; }" >>"$LOG_FILE"
else
  echo "$(date '+%Y-%m-%d %H:%M:%S') FAIL ${out//$'\n'/; }" >>"$LOG_FILE"
  exit 1
fi

# Keep the log from growing unbounded.
tail -n 500 "$LOG_FILE" >"$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
